<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for ZenScreen
  Allows cleartext (HTTP) traffic to local development servers.
  In production, remove base-config cleartext and use HTTPS only.
-->
<network-security-config>

    <!-- DEVELOPMENT: Allow HTTP to ALL domains (needed for local dev server) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicit domains for clarity -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.114</domain>
        <domain includeSubdomains="true">192.168.1.104</domain>
        <domain includeSubdomains="true">172.20.10.4</domain>
        <domain includeSubdomains="true">192.168.137.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>


</network-security-config>

